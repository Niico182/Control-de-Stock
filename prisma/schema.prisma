generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum UserRole {
  SUPERUSER
  ADMIN
  EMPLOYEE
}

enum ProductType {
  SALE
  RENTAL
  BOTH
}

enum StockMovementType {
  INITIAL
  SALE_PRESALE
  SALE_COMPLETE
  SALE_CANCEL
  RENTAL_OUT
  RENTAL_RETURN
  RENTAL_MISSING
  RENTAL_CANCEL
  ADJUSTMENT
}

enum SaleStatus {
  PRESALE
  COMPLETED
  CANCELLED
}

enum RentalStatus {
  ACTIVE
  RETURNED
  CANCELLED
}

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  passwordHash   String
  name           String
  role           UserRole @default(EMPLOYEE)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  memberships    CompanyMember[]
  stockMovements StockMovement[]
  invitationsSent Invitation[] @relation("InvitedBy")
}

model Company {
  id            String   @id @default(uuid())
  name          String
  slug          String   @unique
  enableSales   Boolean  @default(true)
  enableRentals Boolean  @default(true)
  currency      String   @default("ARS")
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  members      CompanyMember[]
  products     Product[]
  categories   ProductCategory[]
  saleOrders   SaleOrder[]
  rentalOrders RentalOrder[]
  invitations  Invitation[]
}

model CompanyMember {
  id                String   @id @default(uuid())
  userId            String
  companyId         String
  canManageProducts Boolean  @default(false)
  canCreateOrders   Boolean  @default(true)
  canViewReports    Boolean  @default(false)
  canManageMembers  Boolean  @default(false)
  createdAt         DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
}

model Invitation {
  id                  String    @id @default(uuid())
  email               String
  companyId           String
  token               String    @unique
  invitedById         String
  expiresAt           DateTime
  usedAt              DateTime?
  canManageProducts   Boolean   @default(false)
  canCreateOrders     Boolean   @default(true)
  canViewReports      Boolean   @default(false)
  canManageMembers    Boolean   @default(false)
  createdAt           DateTime  @default(now())

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invitedBy User    @relation("InvitedBy", fields: [invitedById], references: [id])

  @@index([email, companyId])
}

model ProductCategory {
  id             String      @id @default(uuid())
  companyId      String
  name           String
  normalizedName String
  type           ProductType
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([companyId, type, normalizedName])
  @@index([companyId, type])
}

model Product {
  id          String      @id @default(uuid())
  companyId   String
  name        String
  categoryId  String?
  description String?
  basePrice   Decimal
  baseCost    Decimal?
  type        ProductType @default(BOTH)
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  company  Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category ProductCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants ProductVariant[]

  @@index([companyId])
}

model ProductVariant {
  id                   String   @id @default(uuid())
  productId            String
  companyId            String
  sku                  String
  label                String
  attributes           Json     @default("{}")
  normalizedAttributes String   @default("")
  price                Decimal?
  cost                 Decimal?
  quantityTotal        Int      @default(0)
  quantityReserved     Int      @default(0)
  quantityRented       Int      @default(0)
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  product          Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  stockMovements   StockMovement[]
  saleOrderItems   SaleOrderItem[]
  rentalOrderItems RentalOrderItem[]
  rentalReturnItems RentalReturnItem[]

  @@unique([companyId, sku])
  @@unique([productId, normalizedAttributes])
  @@index([companyId])
  @@index([productId])
}

model StockMovement {
  id               String            @id @default(uuid())
  companyId        String
  productVariantId String
  userId           String?
  type             StockMovementType
  quantity         Int
  referenceType    String?
  referenceId      String?
  notes            String?
  createdAt        DateTime          @default(now())

  productVariant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  user           User?          @relation(fields: [userId], references: [id])

  @@index([companyId, productVariantId])
}

model SaleOrder {
  id          String     @id @default(uuid())
  companyId   String
  clientName  String
  status      SaleStatus @default(PRESALE)
  totalPrice  Decimal
  notes       String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  completedAt DateTime?
  cancelledAt DateTime?

  company Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items   SaleOrderItem[]

  @@index([companyId, status])
  @@index([companyId, createdAt])
}

model SaleOrderItem {
  id               String  @id @default(uuid())
  saleOrderId      String
  productVariantId String
  quantity         Int
  unitPrice        Decimal

  saleOrder      SaleOrder      @relation(fields: [saleOrderId], references: [id], onDelete: Cascade)
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])
}

model RentalOrder {
  id          String       @id @default(uuid())
  companyId   String
  clientName  String
  address     String
  rentalDate  DateTime
  status      RentalStatus @default(ACTIVE)
  totalPrice  Decimal
  notes       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  returnedAt  DateTime?
  cancelledAt DateTime?

  company Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items   RentalOrderItem[]
  return  RentalReturn?

  @@index([companyId, status])
  @@index([companyId, rentalDate])
}

model RentalOrderItem {
  id               String  @id @default(uuid())
  rentalOrderId    String
  productVariantId String
  quantity         Int
  unitPrice        Decimal

  rentalOrder    RentalOrder    @relation(fields: [rentalOrderId], references: [id], onDelete: Cascade)
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])
}

model RentalReturn {
  id            String   @id @default(uuid())
  rentalOrderId String   @unique
  notes         String?
  createdAt     DateTime @default(now())

  rentalOrder RentalOrder        @relation(fields: [rentalOrderId], references: [id], onDelete: Cascade)
  items       RentalReturnItem[]
}

model RentalReturnItem {
  id               String @id @default(uuid())
  rentalReturnId   String
  productVariantId String
  quantityReturned Int
  quantityMissing  Int    @default(0)

  rentalReturn   RentalReturn   @relation(fields: [rentalReturnId], references: [id], onDelete: Cascade)
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])
}
